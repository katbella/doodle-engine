{
    "name": "doodle-engine",
    "private": true,
    "author": "Kat Bella",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/katbella/doodle-engine"
    },
    "packageManager": "yarn@4.6.0",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn workspaces foreach -At --topological-dev run build",
        "dev": "yarn workspaces foreach -Ap run dev",
        "studio": "yarn workspace @doodle-engine/studio dev",
        "test": "yarn workspaces foreach -A run test && yarn test:release",
        "test:release": "node --test \"scripts/__tests__/*.test.mjs\"",
        "test:frontend": "yarn workspace @doodle-engine/react test && yarn workspace @doodle-engine/studio test",
        "test:coverage": "yarn workspaces foreach -A run test:coverage",
        "test:e2e": "yarn workspace @doodle-engine/studio test:e2e",
        "typecheck": "yarn workspace @doodle-engine/studio typecheck",
        "build:packages": "yarn workspaces foreach -At --exclude @doodle-engine/studio run build",
        "sync:bundled-assets": "node scripts/sync-bundled-assets.mjs",
        "docs:dev": "yarn --cwd docs dev",
        "docs:build": "yarn --cwd docs build && node --test scripts/__tests__/docs-screenshots.test.mjs"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "devDependencies": {
        "extract-zip": "2.0.1",
        "prettier": "3.8.1"
    }
}
